#!/usr/bin/env python3
import argparse
import json
import os
import re
import shutil
import socket
import time
import subprocess
import sys
from typing import Any, Dict, List, Optional, Tuple

SAFE_START_VOLUME_PERCENT = 2
SAFE_RAMP_TARGET_PERCENT = 100
SAFE_RAMP_STEPS = 16
SAFE_RAMP_STEP_DELAY_SEC = 0.03
SAFE_DISCONNECT_STEP_DELAY_SEC = 0.02
SAFE_TUNNEL_APPEAR_TIMEOUT_SEC = 8.0
LAN_PROBE_TIMEOUT_SEC = 0.6
WATCH_POLL_INTERVAL_SEC = 3.0
WATCH_BACKOFF_START_SEC = 1.0
WATCH_BACKOFF_MAX_SEC = 30.0


def run(cmd: List[str], check: bool = True) -> str:
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        return out
    except subprocess.CalledProcessError as e:
        if check:
            raise RuntimeError(e.output.strip())
        return e.output


def require_tool(name: str) -> None:
    if shutil.which(name) is None:
        raise RuntimeError(f"Missing required tool: {name}")


def config_path() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "pwlink", "config.json")


def load_config() -> Dict[str, Any]:
    path = config_path()
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save_config(cfg: Dict[str, Any]) -> None:
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)


def sanitize_name(name: str) -> str:
    name = name.lower()
    name = re.sub(r"[^a-z0-9_-]+", "_", name)
    return name.strip("_") or "remote"


def discover_mdns() -> List[Dict[str, str]]:
    # Try common service types for Pulse/pipewire-pulse
    services = ["_pulse._tcp", "_pulse-native._tcp"]
    if shutil.which("avahi-browse") is None:
        return []
    found: Dict[str, Dict[str, str]] = {}
    for svc in services:
        out = run(["avahi-browse", "-rt", svc], check=False)
        for line in out.splitlines():
            # Example: =;eth0;IPv4;hostname;_pulse._tcp;local;hostname.local;4713;""
            if not line or line.startswith("+") or line.startswith("=") is False:
                continue
            parts = line.split(";")
            if len(parts) < 9:
                continue
            name = parts[3]
            host = parts[6]
            port = parts[8]
            if not name or not host or not port:
                continue
            found[name] = {"name": name, "host": host, "port": port}
    return list(found.values())


def list_endpoints() -> List[Dict[str, str]]:
    eps = discover_mdns()
    cfg = load_config()
    cached = cfg.get("cached_endpoints") or []
    # Merge, prefer mDNS
    by_name = {e["name"]: e for e in cached if isinstance(e, dict)}
    for e in eps:
        by_name[e["name"]] = e
    merged = list(by_name.values())
    cfg["cached_endpoints"] = merged
    save_config(cfg)
    return merged


def resolve_mdns_ip(host: str) -> Optional[str]:
    """Resolve a .local name to an IPv4 address via avahi.

    nss-mdns is not wired into the resolver here (getent hosts pipe.local
    fails), so getaddrinfo cannot turn a .local name into an address and
    neither can module-tunnel-sink. Ask avahi directly and hand the tunnel
    a literal IP.
    """
    if shutil.which("avahi-resolve") is None:
        return None
    out = run(["avahi-resolve", "-4", "-n", host], check=False)
    parts = out.split()
    if len(parts) >= 2 and parts[1].count(".") == 3:
        return parts[1]
    return None


def host_reachable(host: str, port: str, timeout: float = LAN_PROBE_TIMEOUT_SEC) -> bool:
    """Best-effort TCP probe used to tell a live LAN path from a dead one."""
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except (OSError, ValueError, OverflowError):
        return False


def resolve_tailscale_host(name: str) -> Optional[str]:
    if shutil.which("tailscale") is None:
        return None
    try:
        out = run(["tailscale", "status", "--json"], check=False)
        data = json.loads(out)
        for peer in data.get("Peer", {}).values():
            if peer.get("HostName") == name or peer.get("DNSName", "").split(".")[0] == name:
                for ip in peer.get("TailscaleIPs", []):
                    if ip.count(".") == 3:
                        return ip
    except Exception:
        return None
    return None


def lan_candidate(endpoint: Dict[str, str]) -> Optional[Dict[str, str]]:
    """Return endpoint with host pinned to a reachable LAN IP, else None."""
    host = endpoint["host"]
    port = endpoint["port"]
    if host.endswith(".local"):
        ip = resolve_mdns_ip(host)
        if ip is None:
            return None
        host = ip
    if not host_reachable(host, port):
        return None
    return {"name": endpoint["name"], "host": host, "port": port}


def find_endpoint(query: str, endpoints: List[Dict[str, str]]) -> Dict[str, str]:
    # Direct host:port always wins; the user asked for a specific path.
    if ":" in query and re.match(r"^[^:]+:\d+$", query):
        host, port = query.split(":", 1)
        return {"name": host, "host": host, "port": port}

    q = query.lower()
    matches = [e for e in endpoints if q in e["name"].lower()]
    if len(matches) > 1:
        lines = ["Multiple matches:"]
        for e in matches:
            lines.append(f"  {e['name']} -> {e['host']}:{e['port']}")
        raise RuntimeError("\n".join(lines))

    # Prefer a LAN path over Tailscale. Tailscale can route same-room traffic
    # through a DERP relay (observed: a relay in Frankfurt for a host one room
    # away), which flaps and kills the tunnel. Only fall back to it when the
    # host genuinely is not reachable on the local network.
    candidates = list(matches)
    if "." not in query:
        candidates.append({"name": query, "host": f"{query}.local", "port": "4713"})

    seen = set()
    for cand in candidates:
        key = (cand["host"], cand["port"])
        if key in seen:
            continue
        seen.add(key)
        lan = lan_candidate(cand)
        if lan:
            return lan

    ts_ip = resolve_tailscale_host(query)
    if ts_ip:
        return {"name": query, "host": ts_ip, "port": "4713"}

    if matches:
        return matches[0]
    raise RuntimeError(f"No endpoint matching '{query}'")


def pactl_list_modules() -> str:
    require_tool("pactl")
    return run(["pactl", "list", "modules"], check=False)


def load_tunnel_sink(
    endpoint: Dict[str, str],
    fmt: Optional[str],
    rate: Optional[int],
    channels: Optional[int],
    latency_ms: Optional[int],
) -> int:
    require_tool("pactl")
    sink_name = f"pwlink_{sanitize_name(endpoint['name'])}"
    args = [
        "pactl",
        "load-module",
        "module-tunnel-sink",
        f"server={endpoint['host']}:{endpoint['port']}",
        f"sink_name={sink_name}",
    ]
    if fmt:
        args.append(f"format={fmt}")
    if rate:
        args.append(f"rate={rate}")
    if channels:
        args.append(f"channels={channels}")
    if latency_ms:
        args.append(f"latency_msec={latency_ms}")
    out = run(args)
    try:
        return int(out.strip())
    except ValueError:
        raise RuntimeError(f"Unexpected pactl output: {out.strip()}")


def set_default_sink(sink_name: str) -> None:
    require_tool("pactl")
    run(["pactl", "set-default-sink", sink_name])


def set_sink_mute(sink_name: str, muted: bool) -> None:
    require_tool("pactl")
    run(["pactl", "set-sink-mute", sink_name, "1" if muted else "0"], check=False)


def set_sink_volume_percent(sink_name: str, percent: int) -> None:
    require_tool("pactl")
    pct = max(0, min(150, int(percent)))
    run(["pactl", "set-sink-volume", sink_name, f"{pct}%"], check=False)


def ramp_sink_volume(
    sink_name: str,
    start_percent: int,
    end_percent: int,
    steps: int,
    step_delay_sec: float,
) -> None:
    require_tool("pactl")
    steps = max(1, steps)
    start = int(start_percent)
    end = int(end_percent)
    for i in range(steps + 1):
        # Linear ramp to prevent pops/transients at connect/disconnect boundaries.
        p = round(start + (end - start) * (i / steps))
        set_sink_volume_percent(sink_name, p)
        time.sleep(max(0.0, step_delay_sec))


def move_streams(sink_name: str) -> None:
    require_tool("pactl")
    inputs = run(["pactl", "list", "short", "sink-inputs"], check=False)
    for line in inputs.splitlines():
        parts = line.split()
        if not parts:
            continue
        idx = parts[0]
        run(["pactl", "move-sink-input", idx, sink_name], check=False)


def find_sink_by_name(name: str) -> Optional[str]:
    require_tool("pactl")
    out = run(["pactl", "list", "short", "sinks"], check=False)
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == name:
            return parts[1]
    return None


def wait_for_sink(name: str, timeout_sec: float = SAFE_TUNNEL_APPEAR_TIMEOUT_SEC) -> bool:
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        if find_sink_by_name(name):
            return True
        time.sleep(0.1)
    return False


def get_default_sink_name() -> Optional[str]:
    require_tool("pactl")
    out = run(["pactl", "info"], check=False)
    for line in out.splitlines():
        if line.startswith("Default Sink:"):
            return line.split(":", 1)[1].strip()
    return None


def cmd_list() -> int:
    eps = list_endpoints()
    if not eps:
        print("No endpoints found (mDNS empty).")
        return 1
    print("Endpoints:")
    for e in eps:
        print(f"  {e['name']} -> {e['host']}:{e['port']}")
    return 0


def cmd_connect(
    target: Optional[str],
    fmt: Optional[str],
    rate: Optional[int],
    channels: Optional[int],
    latency_ms: Optional[int],
    watch: bool = False,
) -> int:
    require_tool("pactl")
    cfg = load_config()
    endpoint = resolve_target(target, cfg)

    # If module already loaded, reuse
    # Merge format prefs: CLI overrides config
    fmt = fmt or cfg.get("format")
    rate = rate or cfg.get("rate")
    channels = channels or cfg.get("channels")
    latency_ms = latency_ms or cfg.get("latency_ms")

    sink_name = establish_tunnel(endpoint, fmt, rate, channels, latency_ms, cfg)
    cfg["default_endpoint"] = endpoint
    if fmt:
        cfg["format"] = fmt
    if rate:
        cfg["rate"] = rate
    if channels:
        cfg["channels"] = channels
    if latency_ms:
        cfg["latency_ms"] = latency_ms
    save_config(cfg)

    # Soft-start the remote sink to prevent speaker spikes.
    set_sink_mute(sink_name, True)
    set_sink_volume_percent(sink_name, SAFE_START_VOLUME_PERCENT)
    set_default_sink(sink_name)
    move_streams(sink_name)
    time.sleep(0.12)
    set_sink_mute(sink_name, False)
    ramp_sink_volume(
        sink_name,
        SAFE_START_VOLUME_PERCENT,
        SAFE_RAMP_TARGET_PERCENT,
        SAFE_RAMP_STEPS,
        SAFE_RAMP_STEP_DELAY_SEC,
    )
    print(f"Connected: {endpoint['name']} -> {endpoint['host']}:{endpoint['port']}")
    if watch:
        return watch_loop(endpoint, fmt, rate, channels, latency_ms)
    return 0


def resolve_target(
    target: Optional[str], cfg: Dict[str, Any]
) -> Dict[str, str]:
    """Pick the endpoint to connect to, re-running discovery each time.

    Re-resolving on every attempt is deliberate: it lets a reconnect move back
    onto the LAN as soon as the LAN path returns, instead of pinning whatever
    path happened to work first.
    """
    eps = list_endpoints()
    if target is None:
        saved = cfg.get("default_endpoint")
        if saved:
            # Re-resolve by name so a stale saved host (e.g. a VPN address
            # recorded before the LAN path existed) cannot pin us to it.
            name = saved.get("name")
            if name:
                try:
                    return find_endpoint(name, eps)
                except RuntimeError:
                    return saved
            return saved
        if eps:
            return eps[0]
        raise RuntimeError("No endpoints found")
    return find_endpoint(target, eps)


def establish_tunnel(
    endpoint: Dict[str, str],
    fmt: Optional[str],
    rate: Optional[int],
    channels: Optional[int],
    latency_ms: Optional[int],
    cfg: Dict[str, Any],
    quiet: bool = False,
) -> str:
    """Load the tunnel module if the sink is absent. Returns the sink name."""
    sink_name = f"pwlink_{sanitize_name(endpoint['name'])}"
    if find_sink_by_name(sink_name) is None:
        module_id = load_tunnel_sink(endpoint, fmt, rate, channels, latency_ms)
        cfg["module_id"] = module_id
        if not wait_for_sink(sink_name):
            # Clean up module if sink didn't appear
            run(["pactl", "unload-module", str(module_id)], check=False)
            raise RuntimeError(
                "Tunnel sink did not appear within timeout "
                f"({SAFE_TUNNEL_APPEAR_TIMEOUT_SEC:.0f}s). "
                "Receiver may be slow/offline or refused the tunnel."
            )
    elif not quiet:
        print("Connection already established.")
    return sink_name


def drop_stale_module(cfg: Dict[str, Any]) -> None:
    """Unload a tunnel module left behind by a dead connection."""
    module_id = cfg.get("module_id")
    if module_id is None:
        return
    run(["pactl", "unload-module", str(module_id)], check=False)
    cfg["module_id"] = None


def watch_loop(
    endpoint: Dict[str, str],
    fmt: Optional[str],
    rate: Optional[int],
    channels: Optional[int],
    latency_ms: Optional[int],
) -> int:
    """Supervise the tunnel, reconnecting with backoff when the sink vanishes.

    module-tunnel-sink does not retry: when the socket dies the sink simply
    disappears and audio is gone until something reloads the module. This loop
    is that something.
    """
    # Line-buffer so progress is visible when stdout is a pipe or a journal,
    # not just a terminal.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, OSError):
        pass
    sink_name = f"pwlink_{sanitize_name(endpoint['name'])}"
    backoff = WATCH_BACKOFF_START_SEC
    print(f"Watching {sink_name} (Ctrl-C to stop).")
    try:
        while True:
            time.sleep(WATCH_POLL_INTERVAL_SEC)
            if find_sink_by_name(sink_name) is not None:
                backoff = WATCH_BACKOFF_START_SEC
                continue

            print(f"Tunnel {sink_name} disappeared; reconnecting.")
            cfg = load_config()
            drop_stale_module(cfg)
            try:
                target = resolve_target(endpoint.get("name"), cfg)
                sink_name = establish_tunnel(
                    target, fmt, rate, channels, latency_ms, cfg, quiet=True
                )
                cfg["default_endpoint"] = target
                save_config(cfg)
                set_default_sink(sink_name)
                move_streams(sink_name)
                print(
                    f"Reconnected: {target['name']} -> "
                    f"{target['host']}:{target['port']}"
                )
                backoff = WATCH_BACKOFF_START_SEC
            except RuntimeError as e:
                save_config(cfg)
                print(f"Reconnect failed ({e}); retrying in {backoff:.0f}s.")
                time.sleep(backoff)
                backoff = min(backoff * 2, WATCH_BACKOFF_MAX_SEC)
    except KeyboardInterrupt:
        print("\nStopped watching.")
        return 0


def cmd_watch(target: Optional[str]) -> int:
    require_tool("pactl")
    cfg = load_config()
    endpoint = resolve_target(target, cfg)
    sink_name = establish_tunnel(
        endpoint,
        cfg.get("format"),
        cfg.get("rate"),
        cfg.get("channels"),
        cfg.get("latency_ms"),
        cfg,
        quiet=True,
    )
    cfg["default_endpoint"] = endpoint
    save_config(cfg)
    set_default_sink(sink_name)
    move_streams(sink_name)
    print(f"Linked: {endpoint['name']} -> {endpoint['host']}:{endpoint['port']}")
    return watch_loop(
        endpoint,
        cfg.get("format"),
        cfg.get("rate"),
        cfg.get("channels"),
        cfg.get("latency_ms"),
    )


def cmd_disconnect() -> int:
    require_tool("pactl")
    current_default = get_default_sink_name() or ""
    if current_default.startswith("pwlink_"):
        # Soft-stop before switching away/unloading to avoid turn-off pops.
        ramp_sink_volume(
            current_default,
            SAFE_RAMP_TARGET_PERCENT,
            SAFE_START_VOLUME_PERCENT,
            SAFE_RAMP_STEPS,
            SAFE_DISCONNECT_STEP_DELAY_SEC,
        )
        set_sink_mute(current_default, True)
        time.sleep(0.08)

    # pick a non-tunnel sink
    out = run(["pactl", "list", "short", "sinks"], check=False)
    target = None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        name = parts[1]
        if not name.startswith("pwlink_"):
            target = name
            break
    if target:
        set_default_sink(target)
        move_streams(target)

    # unload any tunnel sink modules
    mods = run(["pactl", "list", "short", "modules"], check=False)
    for line in mods.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        mid = parts[0]
        mname = parts[1]
        if mname == "module-tunnel-sink":
            run(["pactl", "unload-module", mid], check=False)

    print("Disconnected")
    return 0


def cmd_status() -> int:
    require_tool("pactl")
    default = get_default_sink_name()
    if not default:
        print("Default sink: unknown")
        return 1
    print(f"Default sink: {default}")
    return 0


def cmd_reset(watch: bool = False) -> int:
    # Full sender-side reset: unload tunnel modules and reconnect saved/default.
    cmd_disconnect()
    return cmd_connect(None, None, None, None, None, watch)


def cmd_selftest() -> int:
    problems: List[str] = []
    for tool in ("pactl", "avahi-browse"):
        if shutil.which(tool) is None:
            problems.append(f"missing tool: {tool}")
    if problems:
        print("Self-test failed:")
        for p in problems:
            print(f"  - {p}")
        return 2
    print("Self-test passed.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="pwlink",
        description="Route PipeWire/PulseAudio to a remote PipeWire-Pulse server",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="List mDNS endpoints")
    p_connect = sub.add_parser("connect", help="Connect to endpoint by name or host:port")
    p_connect.add_argument("target", nargs="?", help="Endpoint name or host:port")
    p_connect.add_argument("--format", help="Sample format, e.g. s24le, s24_32le, s32le, float32le")
    p_connect.add_argument("--rate", type=int, help="Sample rate, e.g. 96000")
    p_connect.add_argument("--channels", type=int, help="Channel count, e.g. 2")
    p_connect.add_argument("--latency-ms", type=int, help="Target latency in ms, e.g. 200")
    p_connect.add_argument(
        "--watch",
        action="store_true",
        help="Stay running and reconnect automatically if the tunnel drops",
    )
    sub.add_parser("disconnect", help="Disconnect from remote sink")
    sub.add_parser("status", help="Show current default sink")
    p_watch = sub.add_parser("watch", help="Supervise the current link and auto-reconnect")
    p_watch.add_argument("target", nargs="?", help="Endpoint name or host:port")
    p_reset = sub.add_parser("reset", help="Reset tunnels and reconnect")
    p_reset.add_argument(
        "--watch",
        action="store_true",
        help="Stay running and reconnect automatically if the tunnel drops",
    )
    sub.add_parser("selftest", help="Check required tools")

    args = parser.parse_args()
    try:
        if args.cmd == "list":
            return cmd_list()
        if args.cmd == "connect":
            return cmd_connect(
                args.target, args.format, args.rate, args.channels, args.latency_ms, args.watch
            )
        if args.cmd == "watch":
            return cmd_watch(args.target)
        if args.cmd == "disconnect":
            return cmd_disconnect()
        if args.cmd == "status":
            return cmd_status()
        if args.cmd == "reset":
            return cmd_reset(args.watch)
        if args.cmd == "selftest":
            return cmd_selftest()
        parser.error("unknown command")
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
